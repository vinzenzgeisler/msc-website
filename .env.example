VITE_POCKETBASE_URL=https://backend.msc-oberlausitz.de
VITE_GA_MEASUREMENT_ID=
VITE_CARTO_BASEMAP_KEY=
VITE_EVENT_API_BASE_URL=
VITE_ENABLE_RACEPIC=false
# RacePic (docs/memory-bank/racepic-architecture.md Abschnitt E). Client-ID des eigenstaendigen
# Fotografen-Cognito-Pools (RacePicStack, MSC-Event-Backend-Repo) - kein Secret, oeffentlicher
# SPA-App-Client. Region i. d. R. identisch mit dem Backend (eu-central-1).
VITE_RACEPIC_PHOTOGRAPHER_CLIENT_ID=
VITE_RACEPIC_AWS_REGION=eu-central-1
# RacePic (Paket 8, Abschnitt G). CloudFront-Domain des RacePic-Media-Buckets
# (RacePicStack.distribution, MSC-Event-Backend-Repo) - liefert Manifeste (manifests/*) und
# oeffentliche Vorschaubilder (public/*) direkt, ohne API-Aufruf.
VITE_RACEPIC_CDN_BASE_URL=
